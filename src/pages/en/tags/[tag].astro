---
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getAllPosts, getTranslationMap } from '@/lib/content';
import { t } from '@/i18n';

export async function getStaticPaths() {
  // Tags are language-agnostic: every tag resolves under both locales, and a
  // tag page lists matching posts regardless of the language they were written in.
  const posts = await getAllPosts();
  const tags = new Set<string>();
  for (const p of posts) for (const tag of p.data.tags) tags.add(tag);

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: CollectionEntry<'posts'>[] };
const lang = 'en' as const;
const translations = await getTranslationMap(lang);
---

<Base
  title={`#${tag} — Miguel Valdes`}
  description={`Posts tagged "${tag}"`}
  lang={lang}
>
  <main class="layout" style="grid-template-columns: 1fr;">
    <section>
      <div class="section-title">
        <span>#{tag}</span>
        <span class="count">{posts.length} {t(lang, 'post.posts')}</span>
      </div>
      {posts.map((post) => (
        <PostCard
          href={`/${post.data.lang}/posts/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang={lang}
          postLang={post.data.lang}
          translationHref={post.data.translationKey ? translations.get(post.data.translationKey) : undefined}
        />
      ))}
    </section>
  </main>
</Base>
