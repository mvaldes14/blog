---
import Base from '@/layouts/Base.astro';
import { formatDate, type Lang } from '@/i18n';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  lang: Lang;
}

const { title, description, pubDate, updatedDate, tags, lang } = Astro.props;
---

<Base title={`${title} — Miguel Valdes`} description={description} lang={lang}>
  <article class="prose">
    <div class="post-meta">
      <span>{formatDate(pubDate, lang)}</span>
      {updatedDate && <span>· updated {formatDate(updatedDate, lang)}</span>}
    </div>

    <h1>{title}</h1>
    <div class="post-intro">
      <p class="description">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag-chip" href={`/${lang}/tags/${tag}`}>{tag}</a>
          ))}
        </div>
      )}
    </div>

    <slot />
  </article>
</Base>
