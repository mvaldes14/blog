---
import { formatDate, type Lang } from '@/i18n';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  lang: Lang;
}

const { href, title, description, pubDate, tags, lang } = Astro.props;
---

<article class="post">
  <div class="post-date">
    {formatDate(pubDate, lang)}
  </div>
  <div>
    <h2><a href={href}>{title}</a></h2>
    <p class="post-excerpt">{description}</p>
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <a class="tag-chip" href={`/${lang}/tags/${tag}`}>{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
