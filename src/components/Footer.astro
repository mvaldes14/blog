---
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bottom">
  <div>© {year} Miguel Valdes · {t(lang, 'footer.builtWith')}</div>
  <div class="socials">
    <a href="https://umami.mvaldes.dev/q/github" target="_blank" rel="noopener">github</a>
    <a href="https://umami.mvaldes.dev/q/twitter" target="_blank" rel="noopener">x</a>
    <a href="https://umami.mvaldes.dev/q/linkedin" target="_blank" rel="noopener">linkedin</a>
    <a href="https://umami.mvaldes.dev/q/youtube" target="_blank" rel="noopener">youtube</a>
    <a href="https://umami.mvaldes.dev/q/twitch" target="_blank" rel="noopener">twitch</a>
    <a href="https://umami.mvaldes.dev/q/discord" target="_blank" rel="noopener">discord</a>
    <a href="/en/rss.xml">rss·en</a>
    <a href="/es/rss.xml">rss·es</a>
  </div>
</footer>
