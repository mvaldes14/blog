---
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<nav class="top">
  <div class="nav-inner">
    <a href={`/${lang}`} class="brand">
      <span class="prompt">$</span>mvaldes<span class="cursor"></span>
    </a>
    <div class="nav-links">
      <a href={`/${lang}`}>{t(lang, 'nav.writing')}</a>
      <a href="/video">{t(lang, 'nav.video')}</a>
      <a href="/projects">{t(lang, 'nav.projects')}</a>
      <a href={`/${lang}/about`}>{t(lang, 'nav.about')}</a>
    </div>
  </div>
</nav>
